{
  "name": "damini-marketplace",
  "version": "1.0.0",
  "description": "Damini - Production-Ready Multi-Vendor Marketplace",
  "private": true,
  "workspaces": [
    "server",
    "app",
    "vendor",
    "admin",
    "adsmanager"
  ],
  "scripts": {
    "start": "node server/src/server.js",
    "setup": "npm install && npm run setup:all",
    "setup:all": "npm run setup:server && npm run setup:app && npm run setup:vendor && npm run setup:admin && npm run setup:ads",
    "setup:server": "cd server && npm install",
    "setup:app": "cd app && npm install",
    "setup:vendor": "cd vendor && npm install",
    "setup:admin": "cd admin && npm install",
    "setup:ads": "cd adsmanager && npm install",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:app\" \"npm run dev:vendor\" \"npm run dev:admin\" \"npm run dev:ads\"",
    "dev:server": "cd server && npm run dev",
    "dev:app": "cd app && npm run dev",
    "dev:vendor": "cd vendor && npm run dev",
    "dev:admin": "cd admin && npm run dev",
    "dev:ads": "cd adsmanager && npm run dev",
    "db:migrate": "cd server && npm run db:migrate",
    "db:seed": "cd server && npm run db:seed",
    "db:fresh": "cd server && npm run db:fresh",
    "build": "npm run build:app && npm run build:vendor && npm run build:admin && npm run build:ads",
    "build:app": "cd app && npm run build",
    "build:vendor": "cd vendor && npm run build",
    "build:admin": "cd admin && npm run build",
    "build:ads": "cd adsmanager && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
